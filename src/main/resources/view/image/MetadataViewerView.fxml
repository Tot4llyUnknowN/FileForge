<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      fx:controller="com.fileforge.controller.image.MetadataViewController"
      spacing="15">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Button fx:id="backButton" text="← Back" onAction="#goBack" styleClass="back-button"/>

    <Label text="Image Metadata Viewer" styleClass="page-title"/>
    <Label text="Inspect deep structural EXIF, camera profiles, and file formatting header schemas" styleClass="page-subtitle"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Open Image File" onAction="#chooseFile" styleClass="tool-button"/>
        <Label fx:id="fileLabel" text="No file selected" styleClass="page-subtitle"/>
    </HBox>

    <!-- Unified Metadata Display Grid System -->
    <TableView fx:id="metadataTable" prefHeight="320" maxWidth="750" styleClass="list-view">
        <columns>
            <TableColumn fx:id="categoryColumn" text="Category Block" prefWidth="180"/>
            <TableColumn fx:id="tagColumn" text="Property Tag" prefWidth="180"/>
            <TableColumn fx:id="valueColumn" text="Assigned Value" prefWidth="360"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="statusLabel" text="Awaiting target image upload asset sequence..." styleClass="status-label" wrapText="true"/>

</VBox>
