<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      fx:controller="com.fileforge.controller.image.RotateFlipController"
      spacing="15">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Button fx:id="backButton" text="← Back" onAction="#goBack" styleClass="back-button"/>

    <Label text="Rotate &amp; Flip Workspace" styleClass="page-title"/>
    <Label text="Transform your image grid layout alignments instantly" styleClass="page-subtitle"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Open Target File" onAction="#chooseFile" styleClass="tool-button"/>
        <Label fx:id="fileLabel" text="No file selected" styleClass="page-subtitle"/>
    </HBox>

    <!-- Structural transform panel center workspace -->
    <StackPane prefHeight="350" maxWidth="600" style="-fx-background-color: #f8f9fa; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <ImageView fx:id="previewImage" fitWidth="550" fitHeight="320" preserveRatio="true"/>
    </StackPane>

    <!-- Operational modification control grid -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="↩ 90° CCW" onAction="#rotate90CCW" styleClass="tool-button"/>
        <Button text="↪ 90° CW" onAction="#rotate90CW" styleClass="tool-button"/>
        <Button text="🔃 180°" onAction="#rotate180" styleClass="tool-button"/>
        <Button text="↔ Flip Horizontally" onAction="#flipHorizontal" styleClass="tool-button"/>
        <Button text="↕ Flip Vertically" onAction="#flipVertical" styleClass="tool-button"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button fx:id="saveButton" text="Commit &amp; Save Transformed File..." onAction="#saveImage" disable="true" styleClass="primary-button"/>
        <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>
    </HBox>

</VBox>
