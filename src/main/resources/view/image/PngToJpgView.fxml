<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fileforge.controller.image.PngToJpgController"
      spacing="15">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="PNG to JPG" styleClass="page-title"/>
    <Label text="Convert a PNG image to JPG format" styleClass="page-subtitle"/>

    <Button text="Choose PNG File" onAction="#chooseFile" styleClass="tool-button"/>
    <Label fx:id="fileLabel" text="No file selected" styleClass="page-subtitle"/>

    <ImageView fx:id="previewImage" fitWidth="250" preserveRatio="true"/>

    <HBox spacing="10">
        <Button text="Convert to JPG" onAction="#convert" styleClass="tool-button"/>
        <Button fx:id="backButton" text="Back" onAction="#goBack" styleClass="tool-button"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="page-subtitle"/>

</VBox>