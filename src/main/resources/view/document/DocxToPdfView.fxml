<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      fx:controller="com.fileforge.controller.document.DocxToPdfController"
      spacing="15">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Button fx:id="backButton" text="← Back" onAction="#goBack" styleClass="back-button"/>

    <Label text="DOCX to PDF Converter" styleClass="page-title"/>
    <Label text="Convert modern .docx documents into high-fidelity portable PDFs locally" styleClass="page-subtitle"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Select Word Files" onAction="#handleSelectDocx" styleClass="tool-button"/>
        <Label fx:id="statusLabel" text="No files selected" styleClass="page-subtitle"/>
    </HBox>

    <!-- File Queue List View -->
    <ListView fx:id="fileListView" prefHeight="150" maxWidth="500" styleClass="list-view"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button fx:id="convertButton" text="Merge &amp; Export to PDF..." onAction="#handleConvert" disable="true" styleClass="primary-button"/>
    </HBox>

</VBox>
