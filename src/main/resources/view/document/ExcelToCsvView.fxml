<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fileforge.controller.document.ExcelToCsvController"
      spacing="15">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Excel to CSV" styleClass="page-title"/>
    <Label text="Convert an Excel spreadsheet to CSV format" styleClass="page-subtitle"/>

    <Button text="Choose Excel File" onAction="#chooseFile" styleClass="tool-button"/>
    <Label fx:id="fileLabel" text="No file selected" styleClass="page-subtitle"/>

    <Label text="Sheet to convert:" styleClass="page-subtitle"/>
    <ComboBox fx:id="sheetComboBox" prefWidth="250"/>

    <HBox spacing="10">
        <Button text="Convert to CSV" onAction="#convertToCsv" styleClass="tool-button"/>
        <Button fx:id="backButton" text="Back" onAction="#goBack" styleClass="tool-button"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="page-subtitle"/>

</VBox>